---
interface Props {
  className?: string;
  variant?: 'floating' | 'header' | 'inline';
}

const {
  className = '',
  variant = 'floating'
} = Astro.props;
---

{variant === 'floating' && (
  <div
    id="floating-support-container"
    class={`fixed bottom-5 right-5 z-30 transition-all duration-300 ${className}`}
  >
    <button
      type="button"
      class="open-support-btn inline-flex items-center gap-2 px-3.5 py-2 rounded-full bg-[#0c0e17]/90 hover:bg-[#151928] backdrop-blur-md border border-amber-500/30 hover:border-amber-500/60 text-amber-300 text-xs font-mono font-medium shadow-2xl shadow-amber-950/40 hover:scale-105 active:scale-95 transition-all duration-200 group select-none cursor-pointer"
      title="Support the creator with $1 coffee via Payoneer"
    >
      <span class="text-base group-hover:rotate-12 transition-transform duration-300 inline-block">
        ☕
      </span>
      <span class="tracking-wide">Support $1</span>
    </button>
  </div>
)}

{variant === 'header' && (
  <button
    type="button"
    class={`open-support-btn inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-amber-500/30 bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 text-xs font-mono font-medium transition-all active:scale-95 cursor-pointer ${className}`}
    title="Support the project via Payoneer"
  >
    <span class="text-sm">☕</span>
    <span class="hidden sm:inline">Support $1</span>
  </button>
)}

<script>
  function setupFloatingSupportVisibility() {
    const container = document.getElementById('floating-support-container');
    if (!container) return;

    // Auto-hide button when entering Fullscreen canvas mode
    document.addEventListener('fullscreenchange', () => {
      if (document.fullscreenElement) {
        container.classList.add('opacity-0', 'pointer-events-none');
      } else {
        container.classList.remove('opacity-0', 'pointer-events-none');
      }
    });

    // Also hide when fullscreen overlay component is opened
    const overlay = document.getElementById('fullscreen-overlay');
    if (overlay) {
      const observer = new MutationObserver(() => {
        if (!overlay.classList.contains('hidden')) {
          container.classList.add('opacity-0', 'pointer-events-none');
        } else {
          container.classList.remove('opacity-0', 'pointer-events-none');
        }
      });
      observer.observe(overlay, { attributes: true, attributeFilter: ['class'] });
    }
  }

  setupFloatingSupportVisibility();
  document.addEventListener('astro:page-load', setupFloatingSupportVisibility);
</script>
