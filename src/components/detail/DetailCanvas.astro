---
import type { ArtworkData } from '../../types/artwork';

interface Props {
  artwork: ArtworkData;
}

const { artwork } = Astro.props;
---

<div class="relative w-full aspect-square bg-[#050608] rounded-2xl border border-white/10 overflow-hidden shadow-2xl group">
  <canvas
    id="detail-canvas"
    data-algorithm={artwork.algorithmKey}
    data-params={JSON.stringify(
      artwork.parameters.reduce((acc, p) => ({ ...acc, [p.key]: p.defaultValue }), {})
    )}
    class="w-full h-full block cursor-crosshair"
    role="img"
    aria-label={`Interactive high-resolution canvas of ${artwork.title}`}
  ></canvas>

  <!-- Top Controls HUD -->
  <div class="absolute top-4 left-4 right-4 flex items-center justify-between pointer-events-none z-10">
    <!-- Live FPS & Resolution Indicator -->
    <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-black/60 backdrop-blur-md border border-white/10 text-[11px] font-mono pointer-events-auto">
      <span class="w-2 h-2 rounded-full bg-accent-emerald animate-pulse"></span>
      <span id="fps-display" class="text-slate-200">60 FPS</span>
      <span class="text-slate-600">•</span>
      <span class="text-slate-400">Canvas 2D</span>
    </div>

    <!-- Play/Pause & Reset Quick Buttons -->
    <div class="flex items-center gap-2 pointer-events-auto">
      <button
        type="button"
        id="pause-toggle-btn"
        class="p-2 rounded-lg bg-black/60 backdrop-blur-md border border-white/10 text-slate-300 hover:text-white hover:border-white/20 transition-all active:scale-95 cursor-pointer"
        title="Pause / Resume Animation (Space)"
        aria-label="Pause or resume animation"
      >
        <svg id="pause-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <svg id="play-icon" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </button>

      <button
        type="button"
        id="fullscreen-trigger-btn"
        class="p-2 rounded-lg bg-black/60 backdrop-blur-md border border-white/10 text-slate-300 hover:text-white hover:border-white/20 transition-all active:scale-95 cursor-pointer"
        title="Fullscreen Mode (F)"
        aria-label="Toggle fullscreen mode"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Bottom Interaction Hint -->
  <div class="absolute bottom-4 left-4 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-300">
    <span class="px-2.5 py-1 rounded-md bg-black/60 backdrop-blur-md text-[10px] font-mono text-slate-400 border border-white/10">
      Click + Drag to interact with field
    </span>
  </div>
</div>

<script>
  import { CanvasEngine } from '../../engine/CanvasEngine';
  import { getAlgorithmRenderer } from '../../algorithms/registry';

  let currentEngine: CanvasEngine | null = null;
  let isPaused = false;

  async function initDetailCanvas() {
    if (currentEngine) {
      currentEngine.destroy();
      currentEngine = null;
    }

    const canvas = document.getElementById('detail-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const algorithmKey = canvas.getAttribute('data-algorithm') || 'organic-wave';
    const paramsJson = canvas.getAttribute('data-params') || '{}';
    let params = {};
    try {
      params = JSON.parse(paramsJson);
    } catch (e) {
      console.error(e);
    }

    const fpsDisplay = document.getElementById('fps-display');
    const renderer = await getAlgorithmRenderer(algorithmKey);
    if (!canvas.isConnected) return;

    currentEngine = new CanvasEngine({
      canvas,
      renderer,
      initialParams: params,
      interactive: true,
      onFpsUpdate: (fps) => {
        if (fpsDisplay) fpsDisplay.textContent = `${fps} FPS`;
      }
    });

    currentEngine.start();

    // Attach global engine reference for parameter sliders
    (window as any).__MATH_ART_ENGINE__ = currentEngine;

    // Pause/Play toggle setup
    const pauseBtn = document.getElementById('pause-toggle-btn');
    const pauseIcon = document.getElementById('pause-icon');
    const playIcon = document.getElementById('play-icon');

    if (pauseBtn) {
      pauseBtn.onclick = () => {
        isPaused = !isPaused;
        if (isPaused) {
          currentEngine?.stop();
          pauseIcon?.classList.add('hidden');
          playIcon?.classList.remove('hidden');
        } else {
          currentEngine?.start();
          pauseIcon?.classList.remove('hidden');
          playIcon?.classList.add('hidden');
        }
      };
    }

    // Space key to toggle play/pause
    window.onkeydown = (e) => {
      if (e.code === 'Space' && e.target === document.body) {
        e.preventDefault();
        pauseBtn?.click();
      }
    };
  }

  function cleanupDetailCanvas() {
    if (currentEngine) {
      currentEngine.destroy();
      currentEngine = null;
    }
  }

  initDetailCanvas();
  document.addEventListener('astro:page-load', initDetailCanvas);
  document.addEventListener('astro:before-swap', cleanupDetailCanvas);
</script>
