---
---

<div id="fs-hud" class="fixed top-6 right-6 z-[10000] hidden items-center gap-3 transition-opacity duration-300 pointer-events-none">
  <span class="px-3 py-1.5 rounded-lg bg-black/60 backdrop-blur-md border border-white/10 text-xs font-mono text-slate-300">
    Press <kbd class="font-bold text-accent-cyan">ESC</kbd> or <kbd class="font-bold text-accent-cyan">F</kbd> to exit
  </span>
  <button
    type="button"
    id="close-fullscreen-btn"
    class="p-2 rounded-lg bg-black/60 backdrop-blur-md border border-white/10 text-slate-300 hover:text-white transition-all cursor-pointer pointer-events-auto"
    aria-label="Exit fullscreen"
  >
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
</div>

<style is:global>
  .fs-active {
    position: fixed !important;
    inset: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    max-width: none !important;
    z-index: 9999 !important;
    border-radius: 0 !important;
    border: none !important;
    aspect-ratio: auto !important;
  }
  .fs-active.cursor-idle * {
    cursor: none !important;
  }
</style>

<script>
  let hudTimeout: any = null;
  let isFullscreen = false;

  function setupUniversalFullscreen() {
    const trigger = document.getElementById('fullscreen-trigger-btn');
    const closeBtn = document.getElementById('close-fullscreen-btn');
    const hud = document.getElementById('fs-hud');
    
    // Find the wrapper by going up from the trigger button
    const wrapper = trigger?.closest('.aspect-square');
    if (!trigger || !wrapper || !hud) return;

    function openFullscreen() {
      isFullscreen = true;
      wrapper!.classList.add('fs-active');
      hud!.classList.remove('hidden');
      hud!.classList.add('flex');
      resetHudTimeout();
    }

    function closeFullscreen() {
      isFullscreen = false;
      wrapper!.classList.remove('fs-active');
      wrapper!.classList.remove('cursor-idle');
      hud!.classList.add('hidden');
      hud!.classList.remove('flex');
    }

    function resetHudTimeout() {
      if (!isFullscreen) return;
      hud!.style.opacity = '1';
      wrapper!.classList.remove('cursor-idle');
      
      clearTimeout(hudTimeout);
      hudTimeout = setTimeout(() => {
        if (!isFullscreen) return;
        hud!.style.opacity = '0';
        wrapper!.classList.add('cursor-idle');
      }, 2500);
    }

    trigger.addEventListener('click', openFullscreen);
    closeBtn?.addEventListener('click', closeFullscreen);

    // Track mouse movement to hide cursor/HUD
    wrapper.addEventListener('mousemove', resetHudTimeout);

    window.addEventListener('keydown', (e) => {
      // Don't trigger if typing in an input
      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
      
      if (e.key === 'f' || e.key === 'F') {
        if (!isFullscreen) openFullscreen();
        else closeFullscreen();
      } else if (e.key === 'Escape' && isFullscreen) {
        closeFullscreen();
      }
    });
  }

  setupUniversalFullscreen();
  document.addEventListener('astro:page-load', setupUniversalFullscreen);
</script>
