---
import type { ArtworkData } from '../../types/artwork';
import CopyButton from '../common/CopyButton.astro';
import EquationWhiteboardModal from './EquationWhiteboardModal.astro';
import { getPresetCode } from '../../algorithms/playground-presets';
import katex from 'katex';
import 'katex/dist/katex.min.css';

interface Props {
  artwork: ArtworkData;
}

const { artwork } = Astro.props;
const fullExecutableCode = getPresetCode(artwork.slug, artwork.title, artwork.category);

let renderedMath = '';
try {
  renderedMath = katex.renderToString(artwork.mathNotation || '', {
    displayMode: true,
    throwOnError: false,
    output: 'htmlAndMathml',
  });
} catch (err) {
  renderedMath = `<code>${artwork.mathNotation}</code>`;
}
---

<div class="flex flex-col gap-5 p-6 rounded-2xl border border-white/10 bg-[#0c0e17] shadow-xl">
  <!-- Section Title & Meta Header -->
  <div class="flex items-center justify-between gap-4 border-b border-white/[0.06] pb-4">
    <div class="flex items-center gap-2.5">
      <div class="w-5 h-5 rounded bg-accent-cyan/10 border border-accent-cyan/30 flex items-center justify-center text-accent-cyan font-mono text-xs">
        ƒ
      </div>
      <h2 class="text-base font-sans font-semibold text-slate-100">
        Mathematical Formulation & Source Code
      </h2>
    </div>

    <!-- Complexity & Length Badges -->
    <div class="flex items-center gap-2 font-mono text-[11px]">
      <span class="px-2 py-0.5 rounded bg-black/40 border border-white/10 text-slate-400">
        {fullExecutableCode.length} chars
      </span>
      <span class="px-2 py-0.5 rounded bg-black/40 border border-white/10 text-accent-cyan capitalize">
        {artwork.complexity}
      </span>
    </div>
  </div>

  <!-- Real Mathematical Equation Rendering (KaTeX) -->
  <div class="flex flex-col gap-1.5">
    <div class="flex items-center justify-between">
      <span class="text-xs font-mono text-slate-400">Analytical Equation</span>
      <div class="flex items-center gap-2">
        <button
          type="button"
          data-open-whiteboard
          class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-accent-cyan/10 hover:bg-accent-cyan/20 border border-accent-cyan/30 text-accent-cyan text-xs font-mono font-medium transition-all active:scale-95 shadow-sm"
          title="Open Fullscreen Math Whiteboard & Chalkboard"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
          </svg>
          <span>Whiteboard</span>
        </button>
        <CopyButton textToCopy={artwork.mathNotation} label="Copy LaTeX" variant="secondary" />
      </div>
    </div>
    <div
      data-open-whiteboard
      class="group relative p-4 rounded-xl bg-gradient-to-b from-[#0e111a] to-[#08090d] border border-white/[0.08] hover:border-accent-cyan/40 shadow-inner overflow-x-auto text-slate-100 leading-relaxed scrollbar-thin flex items-center justify-center min-h-[4rem] cursor-pointer transition-all hover:shadow-glow"
      title="Click to open Fullscreen Blackboard & Whiteboard"
    >
      <div class="katex-formula text-sm sm:text-base text-accent-cyan py-1 pointer-events-none" set:html={renderedMath} />
      <span class="absolute right-3 top-2.5 text-[10px] font-mono text-accent-cyan/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center gap-1">
        <span>Click to expand</span>
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </span>
    </div>
  </div>

  <!-- Fullscreen Whiteboard / Chalkboard Modal -->
  <EquationWhiteboardModal artwork={artwork} />

  <!-- Compact One-Liner Expression -->
  <div class="flex flex-col gap-1.5">
    <div class="flex items-center justify-between">
      <span class="text-xs font-mono text-slate-400">Compact Formula</span>
      <CopyButton textToCopy={artwork.formulaCompact} label="Copy Formula" variant="secondary" />
    </div>
    <div class="p-3.5 rounded-lg bg-[#08090d] border border-white/[0.06] overflow-x-auto font-mono text-xs text-slate-200 scrollbar-thin">
      <code>{artwork.formulaCompact}</code>
    </div>
  </div>

  <!-- Full Executable Implementation Code Block -->
  <div class="flex flex-col gap-1.5">
    <div class="flex items-center justify-between">
      <span class="text-xs font-mono text-slate-400">Full Executable Algorithm Code</span>
      <CopyButton textToCopy={fullExecutableCode} label="Copy Code" variant="ghost" />
    </div>
    <div class="p-3.5 rounded-lg bg-[#08090d] border border-white/[0.06] overflow-x-auto font-mono text-xs text-slate-300 scrollbar-thin max-h-80">
      <pre><code>{fullExecutableCode}</code></pre>
    </div>
  </div>

  <!-- Quick Action: Remix in Playground -->
  <div class="pt-2 border-t border-white/[0.06] flex items-center justify-between">
    <a
      href={`/playground?preset=${artwork.slug}`}
      class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-accent-cyan/10 hover:bg-accent-cyan/20 border border-accent-cyan/30 text-accent-cyan text-xs font-mono font-medium transition-all active:scale-95 shadow-glow"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
      </svg>
      <span>Open in Playground</span>
    </a>

    <span class="text-[11px] font-mono text-slate-400">
      Zero Dependencies • Standalone
    </span>
  </div>
</div>
