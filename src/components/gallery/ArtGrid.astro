---
import type { ArtworkData } from '../../types/artwork';
import ArtCard from './ArtCard.astro';

interface Props {
  artworks: ArtworkData[];
}

const { artworks } = Astro.props;
---

<div
  id="art-grid"
  class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-5 sm:gap-6"
>
  {artworks.map((artwork, idx) => (
    <ArtCard artwork={artwork} index={idx} />
  ))}
</div>

<script>
  import { CanvasEngine } from '../../engine/CanvasEngine';
  import { getAlgorithmRenderer } from '../../algorithms/registry';

  let observer: IntersectionObserver | null = null;
  const engineMap = new WeakMap<Element, CanvasEngine>();
  const activeEngines: CanvasEngine[] = [];
  let isTabVisible = true;
  let prefersReducedMotion = false;

  function handleVisibilityChange() {
    isTabVisible = !document.hidden;
    activeEngines.forEach((engine) => {
      if (!isTabVisible || prefersReducedMotion) {
        engine.stop();
        if (prefersReducedMotion) engine.renderSingleFrame(1.0);
      } else {
        engine.start();
      }
    });
  }

  function initGridObserver() {
    cleanupGridCanvases();

    isTabVisible = !document.hidden;
    prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.removeEventListener('visibilitychange', handleVisibilityChange);
    document.addEventListener('visibilitychange', handleVisibilityChange);

    const cards = document.querySelectorAll<HTMLElement>('.art-card-container');
    if (cards.length === 0) return;

    if (!('IntersectionObserver' in window)) {
      // Fallback for browsers without IntersectionObserver: lazy load on scroll/idle
      return;
    }

    observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(async (entry) => {
          const card = entry.target as HTMLElement;
          const canvas = card.querySelector<HTMLCanvasElement>('canvas[data-card-canvas]');
          if (!canvas) return;

          if (entry.isIntersecting) {
            let engine = engineMap.get(card);

            if (!engine) {
              const algorithmKey = canvas.getAttribute('data-algorithm') || 'organic-wave';
              const paramsJson = canvas.getAttribute('data-params') || '{}';
              let params = {};
              try {
                params = JSON.parse(paramsJson);
              } catch (e) {
                // Ignore fallback
              }

              try {
                const renderer = await getAlgorithmRenderer(algorithmKey);
                // Check if card is still attached and intersecting
                if (!card.isConnected) return;

                engine = new CanvasEngine({
                  canvas,
                  renderer,
                  initialParams: params,
                });

                engineMap.set(card, engine);
                activeEngines.push(engine);

                if (prefersReducedMotion) {
                  engine.renderSingleFrame(1.0);
                } else if (isTabVisible) {
                  engine.start();
                }
              } catch (err) {
                console.error(`Failed to initialize engine for ${algorithmKey}:`, err);
              }
            } else {
              if (prefersReducedMotion) {
                engine.renderSingleFrame(1.0);
              } else if (isTabVisible) {
                engine.start();
              }
            }
          } else {
            // Out of viewport: pause rAF loop to free CPU & GPU
            const engine = engineMap.get(card);
            if (engine) {
              engine.stop();
            }
          }
        });
      },
      {
        rootMargin: '200px 0px',
        threshold: 0.01,
      }
    );

    cards.forEach((card) => observer!.observe(card));
  }

  function cleanupGridCanvases() {
    if (observer) {
      observer.disconnect();
      observer = null;
    }
    activeEngines.forEach((engine) => engine.destroy());
    activeEngines.length = 0;
    document.removeEventListener('visibilitychange', handleVisibilityChange);
  }

  // Setup on initial mount and Astro view transitions
  initGridObserver();
  document.addEventListener('astro:page-load', initGridObserver);
  document.addEventListener('astro:before-swap', cleanupGridCanvases);
</script>
