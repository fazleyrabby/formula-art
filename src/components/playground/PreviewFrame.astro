---
---

<div class="flex flex-col h-full rounded-2xl border border-white/10 bg-[#0c0e17] overflow-hidden shadow-xl">
  <!-- Header HUD -->
  <div class="flex items-center justify-between px-4 py-3 bg-[#08090d] border-b border-white/[0.08] text-xs font-mono">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-accent-emerald animate-pulse"></span>
      <span class="text-slate-200">Sandbox Preview</span>
      <span id="sandbox-fps" class="text-accent-cyan font-bold pl-2 border-l border-white/10">60 FPS</span>
    </div>

    <div class="flex items-center gap-2">
      <span id="sandbox-status" class="text-[11px] text-slate-400">Isolated Runtime</span>
    </div>
  </div>

  <!-- Sandboxed Iframe Container -->
  <div class="relative flex-1 min-h-[420px] bg-[#050608] flex items-center justify-center p-4">
    <iframe
      id="sandbox-iframe"
      sandbox="allow-scripts"
      class="w-full h-full min-h-[400px] border-0 rounded-lg block bg-[#050608]"
      title="Sandboxed Math Art Runtime"
    ></iframe>

    <!-- Inline Error Toast -->
    <div
      id="sandbox-error-banner"
      class="absolute bottom-4 left-4 right-4 p-3 rounded-lg bg-rose-950/90 border border-rose-500/40 text-rose-200 font-mono text-xs hidden z-20 backdrop-blur-md shadow-2xl"
    >
      <div class="flex items-start justify-between gap-2">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-rose-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span id="sandbox-error-text" class="break-all">Syntax Error</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function setupSandboxIframe() {
    const iframe = document.getElementById('sandbox-iframe') as HTMLIFrameElement;
    const fpsBadge = document.getElementById('sandbox-fps');
    const errorBanner = document.getElementById('sandbox-error-banner');
    const errorText = document.getElementById('sandbox-error-text');

    if (!iframe) return;

    let latestCode: string | null = null;

    // Zero-trust sandbox HTML template
    const sandboxTemplate = `
      <!DOCTYPE html>
      <html>
      <head>
        <style>
          * { margin: 0; padding: 0; box-sizing: border-box; }
          html, body { width: 100%; height: 100%; overflow: hidden; background: #050608; }
          canvas { width: 100%; height: 100%; display: block; }
        </style>
      </head>
      <body>
        <canvas id="c"></canvas>
        <script>
          const canvas = document.getElementById('c');
          const ctx = canvas.getContext('2d');
          let renderFn = null;
          let startTime = performance.now();
          let lastTime = startTime;
          let frameCount = 0;
          let fps = 60;
          let fpsBuffer = [];

          function hsla(h, s, l, a) {
            return 'hsla(' + h + ', ' + s + '%, ' + l + '%, ' + (a !== undefined ? a : 1) + ')';
          }

          function lerp(start, end, t) {
            return start * (1 - t) + end * t;
          }

          function clamp(val, min, max) {
            return Math.min(Math.max(val, min), max);
          }

          function map(val, inMin, inMax, outMin, outMax) {
            return outMin + ((val - inMin) / (inMax - inMin)) * (outMax - outMin);
          }

          function dist(x1, y1, x2, y2) {
            const dx = x2 - x1;
            const dy = y2 - y1;
            return Math.sqrt(dx * dx + dy * dy);
          }

          // Deterministic Noise Generator
          const PERM = new Uint8Array(512);
          const GRAD_X = new Float32Array(512);
          const GRAD_Y = new Float32Array(512);
          (function initNoise() {
            const p = new Uint8Array(256);
            for (let i = 0; i < 256; i++) p[i] = i;
            let seed = 1337;
            for (let i = 255; i > 0; i--) {
              seed = (seed * 16807) % 2147483647;
              const j = seed % (i + 1);
              const tmp = p[i];
              p[i] = p[j];
              p[j] = tmp;
            }
            for (let i = 0; i < 512; i++) {
              PERM[i] = p[i & 255];
              const angle = (PERM[i] / 256) * Math.PI * 2;
              GRAD_X[i] = Math.cos(angle);
              GRAD_Y[i] = Math.sin(angle);
            }
          })();

          function fade(t) {
            return t * t * t * (t * (t * 6 - 15) + 10);
          }

          function noise2D(x, y) {
            const X = Math.floor(x) & 255;
            const Y = Math.floor(y) & 255;
            const xf = x - Math.floor(x);
            const yf = y - Math.floor(y);
            const u = fade(xf);
            const v = fade(yf);
            const aa = PERM[PERM[X] + Y];
            const ab = PERM[PERM[X] + Y + 1];
            const ba = PERM[PERM[X + 1] + Y];
            const bb = PERM[PERM[X + 1] + Y + 1];
            const g1 = GRAD_X[aa] * xf + GRAD_Y[aa] * yf;
            const g2 = GRAD_X[ba] * (xf - 1) + GRAD_Y[ba] * yf;
            const g3 = GRAD_X[ab] * xf + GRAD_Y[ab] * (yf - 1);
            const g4 = GRAD_X[bb] * (xf - 1) + GRAD_Y[bb] * (yf - 1);
            const x1 = lerp(g1, g2, u);
            const x2 = lerp(g3, g4, u);
            return lerp(x1, x2, v);
          }

          function fbm2D(x, y, octaves = 3, lacunarity = 2.0, gain = 0.5) {
            let total = 0;
            let frequency = 1.0;
            let amplitude = 1.0;
            let maxValue = 0;
            for (let i = 0; i < octaves; i++) {
              total += noise2D(x * frequency, y * frequency) * amplitude;
              maxValue += amplitude;
              amplitude *= gain;
              frequency *= lacunarity;
            }
            return total / maxValue;
          }

          function project3D(x, y, z, rotX, rotY, rotZ, cx, cy, fov, distance) {
            fov = fov || 450;
            distance = distance || 520;
            const cosY = Math.cos(rotY), sinY = Math.sin(rotY);
            const x1 = x * cosY + z * sinY;
            const z1 = -x * sinY + z * cosY;

            const cosX = Math.cos(rotX), sinX = Math.sin(rotX);
            const y2 = y * cosX - z1 * sinX;
            const z2 = y * sinX + z1 * cosX;

            const cosZ = Math.cos(rotZ), sinZ = Math.sin(rotZ);
            const x3 = x1 * cosZ - y2 * sinZ;
            const y3 = x1 * sinZ + y2 * cosZ;

            const totalZ = z2 + distance;
            const scale = totalZ > 10 ? fov / totalZ : 0;
            return {
              x: cx + x3 * scale,
              y: cy + y3 * scale,
              scale: scale,
              depth: Math.max(0.1, Math.min(1.6, scale))
            };
          }

          function resize() {
            const dpr = Math.min(window.devicePixelRatio || 1, 2);
            canvas.width = Math.floor(window.innerWidth * dpr);
            canvas.height = Math.floor(window.innerHeight * dpr);
          }
          window.addEventListener('resize', resize);
          resize();

          function loop(now) {
            const dt = Math.min((now - lastTime) / 1000, 0.1);
            lastTime = now;
            const elapsed = (now - startTime) / 1000;

            if (dt > 0) {
              fpsBuffer.push(1 / dt);
              if (fpsBuffer.length > 20) fpsBuffer.shift();
              fps = Math.round(fpsBuffer.reduce((a, b) => a + b, 0) / fpsBuffer.length);
              if (frameCount % 30 === 0) {
                window.parent.postMessage({ type: 'STATUS', fps, hasError: false }, '*');
              }
            }
            frameCount++;

            if (renderFn) {
              try {
                renderFn(ctx, canvas.width, canvas.height, elapsed, dt, project3D, hsla, noise2D, fbm2D);
              } catch (err) {
                window.parent.postMessage({ type: 'STATUS', fps: 0, hasError: true, error: err.message }, '*');
              }
            }
            requestAnimationFrame(loop);
          }
          requestAnimationFrame(loop);

          window.addEventListener('message', (e) => {
            if (e.data && e.data.type === 'EXECUTE') {
              try {
                // Clear any cached instances on new code execution
                window.__art_instances = {};
                // Compile user code with full project3D, hsla, and noise scope
                renderFn = new Function('ctx', 'width', 'height', 'time', 'dt', 'project3D', 'hsla', 'noise2D', 'fbm2D', e.data.code);
                window.parent.postMessage({ type: 'STATUS', fps, hasError: false }, '*');
              } catch (err) {
                window.parent.postMessage({ type: 'STATUS', fps: 0, hasError: true, error: err.message }, '*');
              }
            }
          });
        <\/script>
      </body>
      </html>
    `;

    iframe.srcdoc = sandboxTemplate;

    function sendCodeToIframe(code: string) {
      if (!code) return;
      latestCode = code;
      try {
        if (iframe.contentWindow) {
          iframe.contentWindow.postMessage({ type: 'EXECUTE', code }, '*');
        }
      } catch (e) {
        console.warn('Sandbox postMessage error:', e);
      }
    }

    iframe.addEventListener('load', () => {
      if (latestCode) {
        sendCodeToIframe(latestCode);
      }
    });

    // Listen to messages from sandbox
    window.addEventListener('message', (e) => {
      if (e.data && e.data.type === 'STATUS') {
        if (fpsBadge && !e.data.hasError) {
          fpsBadge.textContent = `${e.data.fps || 60} FPS`;
        }

        if (e.data.hasError) {
          if (errorBanner && errorText) {
            errorText.textContent = e.data.error || 'Runtime error in formula';
            errorBanner.classList.remove('hidden');
          }
        } else {
          errorBanner?.classList.add('hidden');
        }
      }
    });

    // Execute user code
    window.addEventListener('math-art:run-code', ((e: CustomEvent) => {
      const code = e.detail?.code;
      if (code) {
        sendCodeToIframe(code);
      }
    }) as EventListener);
  }

  setupSandboxIframe();
  document.addEventListener('astro:page-load', setupSandboxIframe);
</script>
