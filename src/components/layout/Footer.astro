---
---

<footer class="w-full border-t border-white/[0.06] bg-[#08090d] py-12 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="flex items-center gap-3">
      <div class="w-6 h-6 rounded bg-gradient-to-br from-accent-cyan to-accent-indigo flex items-center justify-center">
        <span class="font-mono font-bold text-slate-950 text-[10px]">ƒ</span>
      </div>
      <p class="text-xs text-slate-400 font-mono">
        <span class="text-slate-200 font-semibold">MATH.ART</span> — Minimalist Mathematical Generative Playground
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-4 sm:gap-6 text-xs text-slate-400 font-mono">
      <!-- Live Visitor Counter -->
      <div
        id="visitor-counter-container"
        class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-white/[0.03] border border-white/[0.08] text-[11px]"
        title="Unique Visitor Counter (Excludes Local & Admin IPs)"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-accent-emerald animate-pulse"></span>
        <span class="text-slate-400">Visitors:</span>
        <span id="visitor-count" class="text-slate-200 font-bold tracking-wider">...</span>
        <span id="visitor-admin-badge" class="hidden text-[9px] px-1 py-0.2 rounded bg-accent-cyan/15 text-accent-cyan font-mono">OWN IP</span>
      </div>

      <span class="text-slate-700 hidden sm:inline">•</span>
      <a href="/" class="hover:text-accent-cyan transition-colors">Gallery</a>
      <a href="/playground" class="hover:text-accent-cyan transition-colors">Playground</a>
      <span class="text-slate-700 hidden sm:inline">•</span>
      <span class="text-slate-400">Zero Dependencies • 60 FPS Canvas</span>
    </div>
  </div>
</footer>

<script>
  async function initVisitorCounter() {
    const countEl = document.getElementById('visitor-count');
    const adminBadge = document.getElementById('visitor-admin-badge');
    if (!countEl) return;

    const DOMAIN = 'art.fazleyrabbi.xyz';

    // 1. Check for explicit admin ignore trigger in URL (e.g. ?ignore_ip=true or ?admin=true)
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('ignore_ip') === 'true' || urlParams.get('admin') === 'true' || urlParams.get('ignore') === 'true') {
      localStorage.setItem('formula_ignore_analytics', 'true');
    }

    // 2. Determine if current client should be ignored from counting
    const isLocalhost = ['localhost', '127.0.0.1', '0.0.0.0'].includes(window.location.hostname);
    const isIgnoredAdmin = localStorage.getItem('formula_ignore_analytics') === 'true';
    const isAlreadyCountedInSession = sessionStorage.getItem('formula_visitor_counted') === 'true';

    const shouldIgnoreIncrement = isLocalhost || isIgnoredAdmin || isAlreadyCountedInSession;

    if ((isLocalhost || isIgnoredAdmin) && adminBadge) {
      adminBadge.classList.remove('hidden');
    }

    try {
      // If we should ignore, perform read-only fetch
      const endpoint = shouldIgnoreIncrement
        ? `https://counterapi.com/api/${DOMAIN}/visitors/`
        : `https://counterapi.com/api/${DOMAIN}/visitors/up`;

      const res = await fetch(endpoint);
      if (res.ok) {
        const data = await res.json();
        const count = Number(data.value || data.count || 1);
        countEl.textContent = count.toLocaleString();

        if (!shouldIgnoreIncrement) {
          sessionStorage.setItem('formula_visitor_counted', 'true');
        }
      } else {
        // Fallback read
        const fallbackRes = await fetch(`https://counterapi.com/api/${DOMAIN}/visitors/`);
        if (fallbackRes.ok) {
          const fbData = await fallbackRes.json();
          countEl.textContent = Number(fbData.value || 1).toLocaleString();
        }
      }
    } catch (e) {
      // Offline fallback
      countEl.textContent = '1';
    }
  }

  initVisitorCounter();
  document.addEventListener('astro:page-load', initVisitorCounter);
</script>
