---
---

<header class="sticky top-0 z-40 w-full border-b border-white/[0.06] bg-[#08090d]/80 backdrop-blur-xl transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Logo -->
    <div class="flex items-center gap-6">
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-accent-cyan to-accent-indigo flex items-center justify-center shadow-glow group-hover:scale-105 transition-transform duration-300">
          <span class="font-mono font-bold text-slate-950 text-sm">ƒ(x)</span>
        </div>
        <div class="flex flex-col">
          <span class="font-mono font-semibold text-slate-100 tracking-tight text-base group-hover:text-accent-cyan transition-colors">
            MATH<span class="text-accent-cyan">.ART</span>
          </span>
          <span class="text-[10px] text-slate-400 font-mono tracking-wide -mt-1 hidden sm:block">
            Generative Formulas
          </span>
        </div>
      </a>

      <!-- Navigation Links -->
      <nav class="hidden md:flex items-center gap-1 pl-4 border-l border-white/[0.08]">
        <a
          href="/"
          class="px-3 py-1.5 rounded-md text-sm font-medium text-slate-300 hover:text-white hover:bg-white/[0.04] transition-colors"
        >
          Gallery
        </a>
        <a
          href="/playground"
          class="px-3 py-1.5 rounded-md text-sm font-medium text-slate-300 hover:text-white hover:bg-white/[0.04] transition-colors flex items-center gap-1.5"
        >
          <span>Playground</span>
          <span class="px-1.5 py-0.2 rounded text-[10px] font-mono bg-accent-cyan/10 text-accent-cyan border border-accent-cyan/20">LIVE</span>
        </a>
      </nav>
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-2.5">
      <!-- Search Trigger Button -->
      <button
        type="button"
        id="search-trigger"
        class="flex items-center gap-2 px-3 py-1.5 rounded-lg border border-white/[0.08] bg-white/[0.03] hover:bg-white/[0.06] hover:border-white/[0.15] text-slate-400 hover:text-slate-200 transition-all text-xs font-mono group"
        aria-label="Search formulas"
      >
        <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-accent-cyan transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span class="hidden sm:inline">Search...</span>
        <kbd class="hidden sm:inline-block px-1.5 py-0.5 text-[10px] font-mono bg-black/40 border border-white/10 rounded text-slate-400">
          ⌘K
        </kbd>
      </button>

      <!-- Random Discovery Button -->
      <button
        type="button"
        id="random-btn"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-accent-cyan/30 bg-accent-cyan/10 hover:bg-accent-cyan/20 text-accent-cyan text-xs font-mono font-medium transition-all active:scale-95 cursor-pointer shadow-glow"
        title="Discover random formula"
      >
        <svg class="w-3.5 h-3.5 animate-spin-hover" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span>Random</span>
      </button>

      <!-- GitHub Link -->
      <a
        href="https://github.com"
        target="_blank"
        rel="noopener noreferrer"
        class="p-2 rounded-lg border border-white/[0.08] bg-white/[0.02] hover:bg-white/[0.06] text-slate-400 hover:text-white transition-colors"
        aria-label="View on GitHub"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  // All slugs for random navigation
  const slugs = [
    'organic-wave',
    'phyllotaxis-spiral',
    'superformula-bloom',
    'perlin-tendrils',
    'vortex-filament',
    'curl-vector-field',
    'smoke-lattice',
    'viscous-gyre',
    'gravitational-swarm',
    'lissajous-web',
    'brownian-constellation',
    'boids-flocking',
    'hyperbolic-tessellation',
    'sacred-mandala',
    'moire-interference',
    'penrose-subdivision',
    'fourier-harmonics',
    'standing-wave-grid',
    'soliton-pulse',
    'circular-ripples',
    'black-hole-lensing',
    'kepler-orbits',
    'galaxy-spiral-density',
    'continuous-cellular-automata',
    'julia-morph',
    'bioluminescent-jellyfish',
    'mathematical-crab',
    'deep-sea-prawn',
    'manta-ray-glide',
    'nautilus-spiral',
    'fractal-tree',
    'barnsley-fern',
    'gerstner-ocean-waves',
    'coral-polyp-growth',
    'cardiac-pulse',
    'neural-synapse',
    'dna-double-helix',
    'retinal-iris',
    'atmospheric-tornado',
    'water-splash',
    'rain-effect',
    'snow-fall',
    'microscopic-ice-crystal',
    'deep-sea-anglerfish',
    'giant-siphonophore',
    'comb-jelly-ctenophore',
    'vampire-squid',
    'dumbo-octopus',
    'gulper-eel',
    'barreleye-fish',
    'sea-angel-pteropod',
    'abyssal-tripod-fish',
    'giant-spider-crab',
    'leafy-sea-dragon',
    'hammerhead-shark',
    'quantum-hydrogen-orbital',
    'lorenz-attractor-chaos',
    'double-pendulum-chaos',
    'fourier-epicycles-transform',
    'maxwell-em-wave',
    'spacetime-curvature-geodesic'
  ];

  function setupRandomButton() {
    const btn = document.getElementById('random-btn');
    if (!btn || btn.dataset.initialized) return;
    btn.dataset.initialized = 'true';

    btn.addEventListener('click', () => {
      const currentPath = window.location.pathname;
      let target = slugs[Math.floor(Math.random() * slugs.length)];
      
      // Don't pick the same artwork if we're already on an art detail page
      if (currentPath.includes(target) && slugs.length > 1) {
        const filtered = slugs.filter(s => !currentPath.includes(s));
        target = filtered[Math.floor(Math.random() * filtered.length)];
      }

      window.location.href = `/art/${target}`;
    });
  }

  setupRandomButton();
  document.addEventListener('astro:page-load', setupRandomButton);
</script>
