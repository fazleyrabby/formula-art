---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SearchModal from '../components/gallery/SearchModal.astro';
import SupportModal from '../components/common/SupportModal.astro';
import SupportButton from '../components/common/SupportButton.astro';
import CreatorLink from '../components/common/CreatorLink.astro';
import { getCollection } from 'astro:content';
import '../styles/global.css';
import '../styles/canvas.css';
import 'katex/dist/katex.min.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  keywords?: string[];
  type?: 'website' | 'article';
  schema?: Record<string, any>;
}

const {
  title = 'Math Art — 100+ Generative WebGPU, Shaders, & Math Algorithms',
  description = 'A gallery and live playground for computational generative art. Explore real-time WebGPU particle systems, WGSL compute simulations, WebGL shaders, p5.js sketches, and pure 2D Math Canvas algorithms.',
  image = '/og-image.jpg',
  keywords = [
    'math art',
    'generative art',
    'webgpu shaders',
    'wgsl compute',
    'webgl shaders',
    'p5.js sketches',
    'mathematical animations',
    'creative coding',
    'html5 canvas',
    'parametric equations',
    'generative algorithms',
    'fractals',
    'interactive canvas',
    'javascript generative art'
  ],
  type = 'website',
  schema,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://art.fazleyrabbi.xyz');
const [allArtworks, allWebGPU, allShaders, allP5js] = await Promise.all([
  getCollection('artworks'),
  getCollection('webgpu'),
  getCollection('shaders'),
  getCollection('p5js')
]);

const artworksData = [
  ...allArtworks.map(a => ({ ...a.data, route: 'art' })),
  ...allWebGPU.map(a => ({ ...a.data, route: 'webgpu' })),
  ...allShaders.map(a => ({ ...a.data, route: 'shaders' })),
  ...allP5js.map(a => ({ ...a.data, route: 'p5js' }))
];

const defaultSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Math Art',
  url: 'https://art.fazleyrabbi.xyz',
  description: description,
  author: {
    '@type': 'Person',
    name: 'Fazley Rabbi',
    url: 'https://fazleyrabbi.xyz'
  },
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://art.fazleyrabbi.xyz/?q={search_term_string}',
    'query-input': 'required name=search_term_string'
  }
};

const finalSchema = schema || defaultSchema;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <meta name="author" content="Fazley Rabbi" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="theme-color" content="#08090d" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Math Art" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, canonicalURL)} />
    <meta property="twitter:image:alt" content={title} />
    <meta name="twitter:creator" content="@fazley_rabby" />

    <!-- JSON-LD Structured Data Schema -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(finalSchema)} />

    <!-- Google Fonts Optimized Loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;600;700&family=Geist:wght@400;600;700&display=swap" as="style" />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;600;700&family=Geist:wght@400;600;700&display=swap" rel="stylesheet" media="print" onload="this.setAttribute('media', 'all')" />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;600;700&family=Geist:wght@400;600;700&display=swap" rel="stylesheet" />
    </noscript>

    <ClientRouter />
  </head>
  <body class="bg-[#08090d] text-slate-100 min-h-screen flex flex-col antialiased selection:bg-accent-cyan/25 selection:text-accent-cyan">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <SearchModal artworks={artworksData} />
    <SupportButton variant="floating" />
    <CreatorLink />
    <SupportModal
      bmcUsername="fazleyrabbi"
      supportKoriUsername="fazleyrabbi"
      payoneerId="24076084"
    />
  </body>
</html>
