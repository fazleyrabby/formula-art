---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SearchModal from '../components/gallery/SearchModal.astro';
import LemonSqueezyButton from '../components/common/LemonSqueezyButton.astro';
import { getCollection } from 'astro:content';
import '../styles/global.css';
import '../styles/canvas.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Math Art — Generative Mathematical Animations & Formulas',
  description = 'A lightweight gallery and playground for beautiful mathematical generative animations. Inspect formulas, remix in real-time, and copy code.',
  image = '/og-image.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://art.fazleyrabbi.xyz');
const allArtworks = await getCollection('artworks');
const artworksData = allArtworks.map(a => a.data);
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08090d" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, canonicalURL)} />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600;700&family=Geist:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <ClientRouter />
  </head>
  <body class="bg-[#08090d] text-slate-100 min-h-screen flex flex-col antialiased selection:bg-accent-cyan/25 selection:text-accent-cyan">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <SearchModal artworks={artworksData} />
    <LemonSqueezyButton />
  </body>
</html>
