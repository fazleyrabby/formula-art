---
import Layout from '../../layouts/Layout.astro';
import AlgorithmVisualizer from '../../components/algorithms/AlgorithmVisualizer.astro';
import { algorithmDefinitions } from '../../algorithms/visualizations/algorithms';
---

<Layout
  title="Algorithm Visualizer — Math Art"
  description="Explore sorting, searching, graph traversal, and pathfinding algorithms as interactive Canvas visualizations."
  keywords={['algorithm visualizer', 'sorting visualization', 'pathfinding', 'graph algorithms', 'canvas algorithms']}
>
  <div class="max-w-7xl xl:max-w-[1536px] mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <section class="algorithm-hero">
      <div>
        <p class="hero-label">Interactive systems / 14 studies</p>
        <h1>See the algorithm think.</h1>
        <p class="hero-copy">Step through familiar algorithms as living diagrams. Watch comparisons, decisions, and paths resolve one operation at a time.</p>
      </div>
      <div class="hero-note"><span>01</span><p>Choose a study<br />then press Step.</p></div>
    </section>

    <section class="algorithm-layout" aria-label="Algorithm visualizer">
      <aside class="algorithm-index">
        <div class="index-heading"><span>Studies</span><span>{algorithmDefinitions.length}</span></div>
        <label for="algorithm-select">Select an algorithm</label>
        <select id="algorithm-select" data-algorithm-select>
          {algorithmDefinitions.map((algorithm) => <option value={algorithm.id}>{algorithm.title}</option>)}
        </select>
        <div class="algorithm-list">
          {algorithmDefinitions.map((algorithm, index) => (
            <button class:list={["algorithm-item", index === 0 && "is-active"]} data-algorithm-option={algorithm.id} type="button">
              <span class="algorithm-number">{String(index + 1).padStart(2, '0')}</span>
              <span><strong>{algorithm.title}</strong><small>{algorithm.family} · {algorithm.complexity}</small></span>
            </button>
          ))}
        </div>
      </aside>

      <div class="algorithm-stage">
        <div class="stage-heading"><div><p class="hero-label">Now studying</p><h2 data-selected-title>Bubble Sort</h2></div><span data-selected-complexity>O(n²)</span></div>
        <p class="stage-description" data-selected-description>{algorithmDefinitions[0].description}</p>
        <AlgorithmVisualizer />
      </div>
    </section>
  </div>
</Layout>

<script>
  import { algorithmDefinitions } from '../../algorithms/visualizations/algorithms';
  const select = document.querySelector('[data-algorithm-select]') as HTMLSelectElement;
  const title = document.querySelector('[data-selected-title]') as HTMLElement;
  const complexity = document.querySelector('[data-selected-complexity]') as HTMLElement;
  const description = document.querySelector('[data-selected-description]') as HTMLElement;
  const options = document.querySelectorAll('[data-algorithm-option]');
  function sync(id: string) { const item = algorithmDefinitions.find(algorithm => algorithm.id === id) ?? algorithmDefinitions[0]; if (select && select.value !== item.id) { select.value = item.id; select.dispatchEvent(new Event('change')); } if (title) title.textContent = item.title; if (complexity) complexity.textContent = item.complexity; if (description) description.textContent = item.description; options.forEach(option => option.classList.toggle('is-active', option.getAttribute('data-algorithm-option') === item.id)); }
  select?.addEventListener('change', () => sync(select.value));
  options.forEach(option => option.addEventListener('click', () => sync(option.getAttribute('data-algorithm-option') || 'bubble-sort')));
</script>

<style>
  .algorithm-hero { display: flex; justify-content: space-between; align-items: end; gap: 32px; padding-bottom: 36px; border-bottom: 1px solid rgba(255,255,255,.08); }
  .hero-label { margin: 0 0 12px; color: #38bdf8; font: 11px 'Geist Mono', monospace; letter-spacing: .12em; text-transform: uppercase; }
  h1 { max-width: 720px; margin: 0; color: #f8fafc; font: 700 clamp(2.3rem, 6vw, 5.8rem)/.95 Geist, sans-serif; letter-spacing: -.065em; }
  .hero-copy { max-width: 580px; margin: 20px 0 0; color: #94a3b8; font: 16px/1.65 Geist, sans-serif; }
  .hero-note { display: flex; gap: 12px; min-width: 150px; color: #64748b; font: 11px/1.5 'Geist Mono', monospace; text-transform: uppercase; }
  .hero-note span { color: #34d399; }
  .hero-note p { margin: 0; }
  .algorithm-layout { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 42px; padding-top: 42px; }
  .algorithm-index { align-self: start; position: sticky; top: 92px; }
  .index-heading { display: flex; justify-content: space-between; color: #e2e8f0; font: 600 12px 'Geist Mono', monospace; text-transform: uppercase; letter-spacing: .1em; }
  .index-heading span:last-child { color: #64748b; }
  .algorithm-index label { display: block; margin: 24px 0 8px; color: #64748b; font: 11px 'Geist Mono', monospace; }
  select { width: 100%; padding: 10px; border: 1px solid rgba(255,255,255,.1); border-radius: 8px; background: #11151f; color: #e2e8f0; font: 12px 'Geist Mono', monospace; }
  .algorithm-list { display: grid; gap: 3px; margin-top: 22px; }
  .algorithm-item { display: grid; grid-template-columns: 28px 1fr; gap: 8px; width: 100%; padding: 10px 8px; border: 1px solid transparent; border-radius: 8px; background: transparent; color: #94a3b8; text-align: left; cursor: pointer; transition: .2s ease; }
  .algorithm-item:hover, .algorithm-item.is-active { border-color: rgba(56,189,248,.2); background: rgba(56,189,248,.06); color: #f8fafc; }
  .algorithm-number { color: #475569; font: 10px 'Geist Mono', monospace; padding-top: 2px; }
  .algorithm-item strong, .algorithm-item small { display: block; }
  .algorithm-item strong { font: 600 12px Geist, sans-serif; }
  .algorithm-item small { margin-top: 4px; color: #64748b; font: 10px 'Geist Mono', monospace; }
  .stage-heading { display: flex; justify-content: space-between; align-items: end; gap: 18px; }
  .stage-heading .hero-label { margin-bottom: 8px; }
  h2 { margin: 0; color: #f8fafc; font: 600 clamp(1.7rem, 3vw, 2.8rem)/1 Geist, sans-serif; letter-spacing: -.04em; }
  .stage-heading > span { color: #34d399; font: 12px 'Geist Mono', monospace; }
  .stage-description { margin: 12px 0 24px; color: #94a3b8; font: 14px/1.6 Geist, sans-serif; }
  @media (max-width: 850px) { .algorithm-hero { align-items: start; flex-direction: column; } .hero-note { display: none; } .algorithm-layout { grid-template-columns: 1fr; gap: 28px; } .algorithm-index { position: static; } .algorithm-list { display: flex; overflow-x: auto; padding-bottom: 4px; } .algorithm-item { min-width: 170px; } }
</style>
