---
import Layout from '../layouts/Layout.astro';
import CodeEditor from '../components/playground/CodeEditor.astro';
import PreviewFrame from '../components/playground/PreviewFrame.astro';
import { getCollection } from 'astro:content';
import { getPresetCode } from '../algorithms/playground-presets';

const allArtworks = await getCollection('artworks');
allArtworks.sort((a, b) => a.data.id.localeCompare(b.data.id));

const presets = allArtworks.map((a) => ({
  slug: a.data.slug,
  title: a.data.title,
  category: a.data.category,
  code: getPresetCode(a.data.slug, a.data.title, a.data.category)
}));

const defaultCode = presets[0]?.code || '';

const playgroundSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Math Art Formula Generator Studio',
  url: 'https://art.fazleyrabbi.xyz/playground',
  description: 'Live interactive studio for mathematical generative art. Modulate rotary knobs, edit algorithms live, and export animations.',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Any',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD'
  }
};
---

<Layout
  title="Formula Generator Studio & Playground — Math Art"
  description="Generate and live modulate 78+ generative mathematical art formulas using interactive rotary knobs, sliders, and real-time live code editing."
  keywords={[
    'math art playground',
    'generative art studio',
    'live code canvas',
    'interactive rotary knobs',
    'creative coding editor',
    'javascript math animations',
    'canvas 2d studio'
  ]}
  schema={playgroundSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col gap-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-white/[0.06]">
      <div>
        <h1 class="text-2xl sm:text-3xl font-sans font-bold text-white tracking-tight">
          Formula Generator Studio
        </h1>
        <p class="text-xs sm:text-sm text-slate-400 font-sans mt-0.5">
          Live generative coding editor. Modulate variables, customize mathematical algorithms, and test in real-time.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <span class="px-3.5 py-1.5 rounded-lg text-xs font-mono font-medium bg-accent-cyan/15 text-accent-cyan border border-accent-cyan/30 shadow-glow">
          💻 Live Code Studio
        </span>
      </div>
    </div>

    <!-- Presets Bar (Quick Archetypes) -->
    <div class="flex items-center justify-between gap-4 p-3 rounded-xl bg-[#0c0e17]/60 border border-white/[0.06] text-xs font-mono">
      <div class="flex items-center gap-2 overflow-x-auto py-0.5">
        <label for="preset-select" class="text-slate-400 shrink-0 cursor-pointer">Preset Catalog:</label>
        <select
          id="preset-select"
          aria-label="Preset Catalog"
          class="px-3 py-1 rounded-lg bg-[#08090d] border border-white/10 text-xs font-mono text-slate-200 focus:outline-none focus:border-accent-cyan cursor-pointer"
        >
          {presets.map((preset) => (
            <option value={preset.slug}>
              {preset.title} ({preset.category})
            </option>
          ))}
        </select>
      </div>

      <span class="text-[11px] text-slate-400 hidden sm:inline">
        Live Canvas 60 FPS Runtime
      </span>
    </div>

    <!-- Split-Pane: Code Editor on Left, Live Canvas on Right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch min-h-[560px]">
      <!-- Left Panel: Live Code Editor -->
      <div class="lg:col-span-6 flex flex-col h-full">
        <div id="panel-code" class="h-full">
          <CodeEditor initialCode={defaultCode} />
        </div>
      </div>

      <!-- Right Panel: Sandboxed Preview Frame -->
      <div class="lg:col-span-6 flex flex-col h-full">
        <PreviewFrame />
      </div>
    </div>
  </div>
</Layout>

<script is:inline define:vars={{ presets }}>
  function setupPlaygroundView() {
    const select = document.getElementById('preset-select');

    function loadAndRunPreset(slug) {
      const found = presets.find((p) => p.slug === slug);
      if (found) {
        window.dispatchEvent(new CustomEvent('math-art:load-preset', { detail: { code: found.code } }));
        window.dispatchEvent(new CustomEvent('math-art:run-code', { detail: { code: found.code } }));
      }
    }

    // Check URL parameters for preset or load selected preset
    const urlParams = new URLSearchParams(window.location.search);
    const initialPreset = urlParams.get('preset') || (select ? select.value : (presets[0] && presets[0].slug));
    if (initialPreset && select) {
      select.value = initialPreset;
    }
    
    // Initial run of selected preset
    setTimeout(() => {
      if (initialPreset) loadAndRunPreset(initialPreset);
    }, 100);

    select?.addEventListener('change', () => {
      const slug = select.value;
      loadAndRunPreset(slug);
    });
  }

  setupPlaygroundView();
  document.addEventListener('astro:page-load', setupPlaygroundView);
</script>
