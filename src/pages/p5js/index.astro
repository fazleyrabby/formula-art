---
import Layout from '../../layouts/Layout.astro';
import P5Grid from '../../components/gallery/P5Grid.astro';
import { getCollection } from 'astro:content';

const allArtworks = await getCollection('p5js');
allArtworks.sort((a, b) => a.data.id.localeCompare(b.data.id));
const artworksData = allArtworks.map((a) => a.data);
---

<Layout
  title="p5.js Art — Creative Coding Sketches & Op-Art"
  description="Explore interactive creative coding sketches made with p5.js. Inspect immediate-mode drawing algorithms, test live parameters, and remix generative op-art."
  keywords={['p5.js generative art', 'creative coding', 'p5js sketches', 'op art', 'interactive canvas', 'generative algorithms']}
>
  <div class="max-w-7xl xl:max-w-[1536px] 2xl:max-w-[1820px] mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 flex flex-col gap-8">
    <section class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-white/[0.06]">
      <div class="max-w-2xl flex flex-col gap-3">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-sans font-bold tracking-tight text-white leading-tight">
          Creative Coding with p5.js.
        </h1>
        <p class="text-slate-400 text-sm sm:text-base font-sans leading-relaxed max-w-xl">
          Discover interactive and generative art sketches powered by the popular p5.js library.
        </p>
      </div>

      <div class="flex items-center gap-4 sm:gap-6 font-mono text-xs text-slate-400 shrink-0">
        <div class="flex flex-col">
          <span class="text-lg font-bold text-slate-100">{artworksData.length}</span>
          <span class="text-[11px] text-slate-400">Artworks</span>
        </div>
        <div class="h-8 w-px bg-white/[0.08]"></div>
        <div class="flex flex-col">
          <span class="text-lg font-bold text-accent-cyan">p5.js</span>
          <span class="text-[11px] text-slate-400">Instance Mode</span>
        </div>
      </div>
    </section>

    <section aria-label="p5.js Artworks Gallery">
      <P5Grid artworks={artworksData} />
    </section>
  </div>
</Layout>
