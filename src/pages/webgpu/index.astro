---
import Layout from '../../layouts/Layout.astro';
import WebGPUGrid from '../../components/gallery/WebGPUGrid.astro';
import { getCollection } from 'astro:content';

const allArtworks = await getCollection('webgpu');
allArtworks.sort((a, b) => a.data.id.localeCompare(b.data.id));
const artworksData = allArtworks.map((a) => a.data);
---

<Layout
  title="WebGPU Art — Next-Gen Graphics & Compute Simulations"
  description="Explore high-performance WebGPU compute and graphics algorithms running natively in your browser. Real-time WGSL particle physics, raymarched oceans, and cellular simulations."
  keywords={['webgpu', 'wgsl shaders', 'compute shaders', 'gpu simulations', 'ocean simulation', 'creative coding webgpu']}
>
  <div class="max-w-7xl xl:max-w-[1536px] 2xl:max-w-[1820px] mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 flex flex-col gap-8">
    <section class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-white/[0.06]">
      <div class="max-w-2xl flex flex-col gap-3">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-sans font-bold tracking-tight text-white leading-tight">
          Next-Gen Graphics via WebGPU.
        </h1>
        <p class="text-slate-400 text-sm sm:text-base font-sans leading-relaxed max-w-xl">
          Discover high-performance algorithms rendered in real time using the new WebGPU API. Inspect the WGSL shaders, remix parameters, and copy the code.
        </p>
      </div>

      <div class="flex items-center gap-4 sm:gap-6 font-mono text-xs text-slate-400 shrink-0">
        <div class="flex flex-col">
          <span class="text-lg font-bold text-slate-100">{artworksData.length}</span>
          <span class="text-[11px] text-slate-400">Artworks</span>
        </div>
        <div class="h-8 w-px bg-white/[0.08]"></div>
        <div class="flex flex-col">
          <span class="text-lg font-bold text-accent-cyan">WebGPU</span>
          <span class="text-[11px] text-slate-400">Next Gen API</span>
        </div>
      </div>
    </section>

    <section aria-label="WebGPU Artworks Gallery">
      <WebGPUGrid artworks={artworksData} />
    </section>
  </div>
</Layout>
